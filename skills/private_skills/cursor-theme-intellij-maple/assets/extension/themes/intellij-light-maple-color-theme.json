    "terminal.ansiCyan": "#00627A",
    "terminal.ansiWhite": "#D3D5DB",
    "terminal.ansiBrightBlack": "#6C707E",
    "terminal.ansiBrightRed": "#FF5261",
    "terminal.ansiBrightGreen": "#3E9D2E",
    "terminal.ansiBrightYellow": "#C99D00",
    "terminal.ansiBrightBlue": "#3574F0",
    "terminal.ansiBrightMagenta": "#B032C0",
    "terminal.ansiBrightCyan": "#0089A6",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "input.background": "#FFFFFF",
    "input.border": "#C9CCD6",
