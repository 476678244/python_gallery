    "breadcrumb.activeSelectionForeground": "#000000",
    "breadcrumbPicker.background": "#FFFFFF",

    "menu.background": "#FFFFFF",
    "menu.foreground": "#000000",
    "menu.border": "#D3D5DB",
    "menu.selectionBackground": "#D4E2FF",
    "menu.selectionForeground": "#000000",
    "menubar.selectionBackground": "#D4E2FF",
    "menubar.selectionForeground": "#000000",

    "gitDecoration.modifiedResourceForeground": "#2E5C97",
    "gitDecoration.deletedResourceForeground": "#E53E4D",
    "gitDecoration.untrackedResourceForeground": "#067D17",
    "gitDecoration.ignoredResourceForeground": "#9AA1B0",
    "gitDecoration.conflictingResourceForeground": "#871094",
    "gitDecoration.stageModifiedResourceForeground": "#2E5C97",

    "minimap.background": "#FFFFFF",
    "minimapSlider.background": "#C9CCD650",
    "minimapSlider.hoverBackground": "#A8ADB880",

    "peekView.border": "#3574F0",
    "peekViewEditor.background": "#F7F8FA",
    "peekViewEditor.matchHighlightBackground": "#FFD980",
    "peekViewResult.background": "#F7F8FA",
    "peekViewResult.selectionBackground": "#D4E2FF",
    "peekViewTitle.background": "#F7F8FA",

    "notifications.background": "#FFFFFF",
    "notifications.foreground": "#000000",
    "notifications.border": "#D3D5DB",
    "notificationCenterHeader.background": "#F7F8FA",

    "diffEditor.insertedTextBackground": "#067D1720",
    "diffEditor.removedTextBackground": "#E53E4D20",
    "diffEditor.insertedLineBackground": "#067D1714",
    "diffEditor.removedLineBackground": "#E53E4D14"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block",
        "comment.line"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation storage.type.class",
        "keyword.other.documentation",
        "storage.type.documentation"
      ],
      "settings": {
        "foreground": "#9E880D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#2E5C97"
      }
    },
    {
      "name": "Language constants (True/False/None/null)",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#2E5C97"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.escape.python"
      ],
      "settings": {
        "foreground": "#0037A6"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#1750EB"
      }
    },
    {
      "name": "Function / method declaration",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#A0211B"
      }
    },
    {
      "name": "Function call (not declaration)",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.function-call.python entity.name.function"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Built-in function",
      "scope": [
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Decorator / annotation",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "meta.decorator punctuation.decorator",
        "punctuation.definition.decorator",
        "storage.type.annotation",
        "meta.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "name": "Constant / static field",
      "scope": [
        "constant.other.caps",
        "constant.other.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "Instance field / property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.attribute.python",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "Class / type names",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Variables (locals)",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters",
        "variable.parameter.function-call",
        "meta.function.parameters variable.parameter"
      ],
      "settings": {
        "foreground": "#A0211B"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Tags (HTML/XML)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#2E5C97"
      }
    },
    {
      "name": "JSON / object keys",
      "scope": [
        "support.type.property-name.json",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#2E5C97",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3574F0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E53E4D"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#A0211B",
    "property": "#871094",
    "property.declaration": "#871094",
    "variable.constant": "#871094",
    "function": "#000000",
    "function.declaration": "#A0211B",
    "method": "#000000",
    "method.declaration": "#A0211B",
    "class": "#000000",
    "type": "#000000",
    "namespace": "#000000",
    "decorator": "#9E880D",
    "selfParameter": "#2E5C97",
    "builtinConstant": "#2E5C97",
    "keyword": "#2E5C97"
  }
}
