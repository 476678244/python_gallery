# SafeClaw Environment Configuration

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom API endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama Configuration (if using local models)
# OLLAMA_BASE_URL=http://localhost:11434

# Debug Settings
DEBUG=false
LOG_LEVEL=INFO

# DeepAgents Debug Logging
DEEPAGENTS_LOG_LEVEL=DEBUG
DEEPAGENTS_DEBUG=true
PYTHONPATH=/Users/nicole/workspace/github/a476678244/python_gallery

# External deepagents library debug settings
DEEPAGENTS_VERBOSE=1
LANGCHAIN_VERBOSE=true
LANGCHAIN_DEBUG=true
LANGGRAPH_VERBOSE=true

# Memory Settings
MEMORY_PATH=./workspace/memory
ENABLE_VECTOR_SEARCH=false
ACTIVE_MEMORY_MAX=20

# Safety Settings
ENABLE_CONFIRMATION=true
SAFETY_LOG_LEVEL=INFO

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
